# Streamlit Community Cloud Secrets Template (Optional — 100% Free, No Credit Card!)
# Paste into Streamlit Cloud -> App Settings -> Secrets

# Optional: Your public Streamlit app URL so QR codes point straight to it
PUBLIC_APP_URL = "https://your-app-name.streamlit.app"

# Optional: Free Google Gemini Flash API key (https://aistudio.google.com/apikey)
# Enables AI math/glossary refinement, live mic/audio transcription, & grounded summaries
GEMINI_API_KEY = ""
GEMINI_MODEL = "gemini-2.5-flash"

# Optional: Free Supabase PostgreSQL URI (leave empty to use built-in SQLite)
DATABASE_URL = ""

# Optional: Only needed if you also deploy the separate FastAPI WebSocket backend
# BACKEND_URL = "https://your-backend-url"
# PUBLIC_BACKEND_WS_URL = "wss://your-backend-url"
