# =============================================================================
# LectureLens (Python Stack) Environment Variables
# Copy this file to .env and fill in your credentials.
# =============================================================================

# --- Database: Supabase PostgreSQL ---
# Copy the Connection Pooler / Direct URI from Supabase -> Project Settings -> Database
# Example: postgresql+psycopg://postgres.[ref]:[PASSWORD]@aws-0-ap-southeast-1.pooler.supabase.com:6543/postgres
# Leave empty to automatically use local SQLite (./data/lecturelens.db) for instant local testing.
DATABASE_URL=

# Optional Supabase metadata (for reference / future RLS auth)
SUPABASE_URL=
SUPABASE_ANON_KEY=

# --- Math Refinement & Summarization: Google Gemini Flash API ---
# Get a key at https://aistudio.google.com/apikey
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.5-flash

# --- Speech-to-Text: Faster-Whisper + Silero VAD ---
# Production / GPU recommended: large-v3-turbo
# Lightweight CPU laptop testing: base or small
WHISPER_MODEL_SIZE=large-v3-turbo
WHISPER_DEVICE=auto
WHISPER_COMPUTE_TYPE=int8
# Set to "true" to enable automatic Faster-Whisper loading on startup/first audio chunk
WHISPER_ENABLED=true

# --- Backend & Frontend URLs ---
BACKEND_HOST=0.0.0.0
BACKEND_PORT=8000
# Used by Streamlit frontend to reach FastAPI HTTP & WebSocket endpoints
BACKEND_URL=http://127.0.0.1:8000
PUBLIC_BACKEND_WS_URL=ws://127.0.0.1:8000
PUBLIC_APP_URL=http://localhost:8501
